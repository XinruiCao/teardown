{
  "name": "teardown",
  "version": "1.0.0",
  "private": true,
  "description": "A portable AI skill for Codex, Cursor and other assistants that builds interactive 3D machine simulators and videos.",
  "license": "MIT",
  "scripts": {
    "setup": "npm ci && npx playwright install chromium",
    "build": "node sims/build.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:skill": "node scripts/install.mjs",
    "test": "node --test tests/install.test.mjs tests/doctor.test.mjs tests/sfx.test.mjs",
    "test:browser": "node scripts/smoke-browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "esbuild": "0.28.1",
    "playwright": "1.58.2",
    "three": "0.186.1"
  }
}
